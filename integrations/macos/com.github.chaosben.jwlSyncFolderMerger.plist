<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.chaosben.jwlSyncFolderMerger</string>

    <!-- Adjust the paths: executable, sync tool and backup folder. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/me/bin/jwlSyncFolderMerger</string>
        <string>-watch</string>
        <string>-sync</string>
        <string>syncthing</string>
        <string>/Users/me/Sync/JWLibrary</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash or error exit, not after a clean stop. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardErrorPath</key>
    <string>/Users/me/Library/Logs/jwlSyncFolderMerger.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
